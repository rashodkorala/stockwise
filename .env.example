# Required by SEC EDGAR's fair-access policy: identify yourself with a name and email.
SEC_USER_AGENT="Stockwise you@example.com"

# Optional: Massive (massive.com, formerly Polygon.io) for US prices, company names and sectors,
# and, on plans that include them, daily US ETF holdings (ETF Global) and USD/CAD rates.
# Keep the key in .env.local (gitignored); never commit it.
MASSIVE_API_KEY=
# Requests per minute your Massive plan allows (free plan: 5).
MASSIVE_RATE_PER_MIN=

# Optional paid fallback for funds no free source covers (Vanguard Canada such as VEQT, BMO, SPY).
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Where the saved portfolio and fund cache live (default: ./data).
STOCKWISE_DATA_DIR=

# Offline modes: 1 = committed excerpts, live = full snapshots from `pnpm snapshot`.
STOCKWISE_FIXTURES=
